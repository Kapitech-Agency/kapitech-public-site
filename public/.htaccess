Options -MultiViews
RewriteEngine On
RewriteBase /

<IfModule mod_headers.c>
  <FilesMatch "\\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Canonicalize legacy solution URLs used before the /solutions/ information architecture.
RewriteRule ^services/(mvp-design|product-redesign|team-extension)/?$ /solutions/$1 [R=301,L,NE]
RewriteRule ^solutions/(pitch-deck|brand-identity|logo-design|graphic-design|rebranding|ui-ux-design|website-design|website-redesign|product-ux-ui-audit|web-development|mvp-development|landing-page|corporate-websites|wow-websites)/?$ /services/$1 [R=301,L,NE]

# Canonicalize trailing-slash route variants for real directories.
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+)/$ /$1 [R=301,L,NE]

# Keep real files and assets accessible.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Prefer prerendered route entry files when they exist.
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ /$1/index.html [L]

# Insight detail routes are CMS-backed and may not have a physical prerendered
# directory when an article is published after the latest static build.
# Route them explicitly to the SPA entry before the generic fallback.
RewriteCond %{REQUEST_URI} ^/insights/[^/]+/?$
RewriteRule ^ /index.html [L]

# React Router fallback for other client-side routes.
RewriteRule ^ /index.html [L]
