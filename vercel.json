{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/services/mvp-design",
      "destination": "/solutions/mvp-design",
      "permanent": true
    },
    {
      "source": "/services/product-redesign",
      "destination": "/solutions/product-redesign",
      "permanent": true
    },
    {
      "source": "/services/team-extension",
      "destination": "/solutions/team-extension",
      "permanent": true
    }
  ]
}
