{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/services/mvp-design",
      "destination": "/solutions/mvp-design",
      "permanent": true
    },
    {
      "source": "/services/product-redesign",
      "destination": "/solutions/product-redesign",
      "permanent": true
    },
    {
      "source": "/services/team-extension",
      "destination": "/solutions/team-extension",
      "permanent": true
    },
    {
      "source": "/solutions/pitch-deck",
      "destination": "/services/pitch-deck",
      "permanent": true
    },
    {
      "source": "/solutions/brand-identity",
      "destination": "/services/brand-identity",
      "permanent": true
    },
    {
      "source": "/solutions/logo-design",
      "destination": "/services/logo-design",
      "permanent": true
    },
    {
      "source": "/solutions/graphic-design",
      "destination": "/services/graphic-design",
      "permanent": true
    },
    {
      "source": "/solutions/rebranding",
      "destination": "/services/rebranding",
      "permanent": true
    },
    {
      "source": "/solutions/ui-ux-design",
      "destination": "/services/ui-ux-design",
      "permanent": true
    },
    {
      "source": "/solutions/website-design",
      "destination": "/services/website-design",
      "permanent": true
    },
    {
      "source": "/solutions/website-redesign",
      "destination": "/services/website-redesign",
      "permanent": true
    },
    {
      "source": "/solutions/product-ux-ui-audit",
      "destination": "/services/product-ux-ui-audit",
      "permanent": true
    },
    {
      "source": "/solutions/web-development",
      "destination": "/services/web-development",
      "permanent": true
    },
    {
      "source": "/solutions/mvp-development",
      "destination": "/services/mvp-development",
      "permanent": true
    },
    {
      "source": "/solutions/landing-page",
      "destination": "/services/landing-page",
      "permanent": true
    },
    {
      "source": "/solutions/corporate-websites",
      "destination": "/services/corporate-websites",
      "permanent": true
    },
    {
      "source": "/solutions/wow-websites",
      "destination": "/services/wow-websites",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/insights",
      "destination": "/index.html"
    },
    {
      "source": "/insights/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(work|services|about|careers|contact|privacy|terms|ai-instructions|editorial-policy|cookie-policy)",
      "destination": "/$1/index"
    },
    {
      "source": "/(services|solutions)/(mvp-design|product-redesign|team-extension|pitch-deck|brand-identity|logo-design|graphic-design|rebranding|ui-ux-design|website-design|website-redesign|product-ux-ui-audit|web-development|mvp-development|landing-page|corporate-websites|wow-websites)",
      "destination": "/$1/$2/index"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        },
        {
          "key": "X-Permitted-Cross-Domain-Policies",
          "value": "none"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'sha256-YLZzxApf2U3B9Dlag19wUhLyc/nZYLLgYY6B7lZOffI=' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://ams.kapitech.id https://www.googletagmanager.com https://*.googletagmanager.com https://www.google-analytics.com https://*.google-analytics.com; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests; frame-src 'self'"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    }
  ]
}
